{
  "baseUrl": "https://www.flipkart.com",
  "apiBaseUrl": "https://api.flipkart.com",
  "auth": {
    "username": "qa_user",
    "password": "qa_password"
  },
  "testData": {
    "productSearch": {
      "validQuery": "mobile",
      "invalidQuery": "nonexistentproduct"
    },
    "filterOptions": {
      "brands": ["Samsung", "Apple", "OnePlus"],
      "priceRange": {
        "min": 10000,
        "max": 50000
      }
    }
  },
  "timeouts": {
    "default": 30000,
    "api": 15000
  },
  "features": {
    "enableLogging": true,
    "enableMetrics": true
  }
}